classDiagram
    class MainModule {
      <<module main.cpp>>
      +main() int
      +runCampaignGame(game, saves, ui, message) bool
    }
    class ConsoleUI {
      +renderMainMenu(message)
      +renderCampaign(game, message)
      +showStandalone(title, text)
    }
    class CampaignGame {
      -CampaignState state_
      +execute(input) CampaignActionResult
      +replaceState(candidate, error) bool
      +validateState(candidate, error) bool
      +availableEndings() vector
      +endingSummary() EndingSummary
    }
    class CampaignState {
      +CampaignMode mode
      +CampaignPhase phase
      +uint32 seed
      +int season
      +int seasonLimit
      +resourcesAndStability
      +array discovered_16
      +array tribes_6
      +array relations_6
      +vector roster
      +vector squads
      +optional activeMission
      +WarState war
      +vector chronicle
    }
    class CampaignSaveRepository {
      -filesystem_path root_
      +save(state, slot, error) bool
      +load(slot, candidate, error) bool
      +pathFor(slot) filesystem_path
    }
    class EndingPresentation {
      +framesFor(ending) vector
      +play(summary, output, options)
      +renderStatic(ending) string
      +formatSummary(summary) string
    }
    class ExpansionGame {
      -ExpansionState state_
      +execute(input) ExpansionCommandResult
      +validateState(state) OperationResult
    }
    class ExpansionState {
      +ExpansionPhase phase
      +Squad squad
      +Inventory inventory
      +combatAndMissionFields
    }
    class Character {
      +string name
      +Attributes attributes
      +level experience growthPoints
      +life fatigue loyalty
      +equipment_8
    }
    class PermanentSquad {
      +string captain
      +vector members
      +ResidentMission residentMission
      +fatigue eliteExperience
    }
    class WarState {
      +string commander
      +warriors militia
      +playerPower enemyPower front
      +WarOrder order
    }
    class TribeProfile {
      +name leader successor personality
      +vector factions
    }
    class DiplomacyRelation {
      +relation trust fear tradeDependence
      +war truce alliance marriage tribute route
    }
    class FactionState {
      +influence satisfaction crisis
      +demand candidate
    }
    class ChronicleEntry {
      +season importance title detail
    }
    class EndingSummary {
      +ending title epilogue
      +statistics otherRoads importantChronicle
    }

    MainModule --> CampaignGame : 创建并驱动
    MainModule --> ConsoleUI : 刷新页面
    MainModule --> CampaignSaveRepository : 存取档
    MainModule --> EndingPresentation : 播放结算
    ConsoleUI ..> CampaignGame : renderCampaign
    CampaignGame *-- CampaignState
    CampaignGame ..> EndingSummary : 生成
    CampaignSaveRepository ..> CampaignState : 原子保存读取
    CampaignSaveRepository ..> CampaignGame : 调用validateState
    EndingPresentation ..> EndingSummary : 只读显示
    CampaignState *-- "0..1" ExpansionState
    ExpansionGame *-- ExpansionState
    CampaignState *-- "2..64" Character
    CampaignState *-- "1..8" PermanentSquad
    CampaignState *-- WarState
    CampaignState *-- "6" TribeProfile
    CampaignState *-- "6" DiplomacyRelation
    CampaignState *-- "3" FactionState
    CampaignState *-- "1..200" ChronicleEntry
