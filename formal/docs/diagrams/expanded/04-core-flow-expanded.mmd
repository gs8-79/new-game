flowchart TB
    subgraph START[一、开局]
      direction LR
      A([启动程序]) --> B{新游戏或读取存档}
      B -- 新游戏 --> C[设置部落名 首领和模式]
      B -- 读取 --> D[临时解析并校验存档]
      D -- 失败 --> E[提示错误 原状态不变]
      C --> F[进入部落总览]
      D -- 成功 --> F
      E --> B
    end

    subgraph MANAGE[二、部落管理]
      direction LR
      G{选择主要功能}
      G -- 人物小队 --> H[加点 编队 配装 补给 休整]
      G -- 外交贸易 --> I[交谈 送礼 联姻 朝贡 贸易 宣战]
      H --> J{条件与资源是否合法}
      I --> J
      J -- 否 --> K[说明原因且状态不变]
      J -- 是 --> L[原子提交并记录编年史]
      K --> M[返回部落总览]
      L --> M
    end

    F --> G

    subgraph MISSION[三、小队任务与可操控战斗]
      direction LR
      N[选择2至8人小队 地点和物资] --> O[进入任务并操控队长]
      O --> P{移动 采集 使用或遭遇}
      P -- 普通行动 --> Q[队员自动跟随协助 疲劳增加]
      P -- 遭遇外族 --> R{交谈 送礼 贸易 劫掠 进攻 离开}
      R -- 和平处理 --> S[更新物资 关系 信任和派系]
      R -- 发生战斗 --> T[进入不同场地的三段战线]
      T --> U[操控队长或统帅并下达军令]
      U --> V[按速度结算队员与敌方行动]
      V --> W{战斗结束}
      W -- 否 --> U
      W -- 是 --> X[结算伤亡 免费拾取和装备回收]
      Q --> Y{任务是否完成}
      Y -- 否 --> P
      Y -- 是 --> Z[返回营地任务结算]
      S --> Z
      X --> Z
    end

    G -- 派出小队 --> N
    Z --> M

    subgraph SEASON[四、季节与结局结算]
      direction LR
      AA[食物 人口 疲劳与常驻任务结算] --> AB[六部落自主外交与贸易]
      AB --> AC[派系满意度 稳定度与首领更替]
      AC --> AD{覆灭或到达模式结算季}
      AD -- 否 --> AE[进入下一季]
      AD -- 是 --> AF[确定可用结局并生成完整结算]
      AF --> AG[播放可跳过的彩色ASCII动画]
      AG --> AH[显示后日谈 数据 人物去向和编年史]
      AH --> AI{返回菜单或继续沙盒}
      AI -- 继续 --> AE
      AI -- 菜单 --> AJ([返回主菜单])
    end

    G -- 结束季节 --> AA
    AE --> M
